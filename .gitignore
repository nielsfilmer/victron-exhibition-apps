# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code session state — everything under .claude/ EXCEPT
# settings.json (shared project-scoped permissions for the Claude
# Code PR workflow; documented in CLAUDE.md).
# NOTE: must be `.claude/*` (with wildcard) not `.claude/` — git
# can't re-include a file under an excluded directory, but it can
# under wildcard-excluded contents.
.claude/*
!.claude/settings.json

# Build / packaging artifacts
*.zip
# Output of kiosk/build-zips.sh (the per-app installable bundles; published as
# GitHub Release assets by CI, never committed)
dist/

# Kiosk LaunchAgent log files (generated at runtime, not source)
kiosk/*.out.log
kiosk/*.err.log

# Chrome kiosk profile directories (created at runtime in $HOME)
.kiosk-app1-profile/
.kiosk-app2-profile/
.kiosk-app3-center-profile/
.kiosk-app3-left-profile/
.kiosk-app3-right-profile/

app1-slideshow/versions/microgrid/config.js
app1-slideshow/versions/microgrid/media/*
!app1-slideshow/versions/microgrid/media/.gitkeep
app1-slideshow/versions/ess/config.js
app1-slideshow/versions/ess/media/*
!app1-slideshow/versions/ess/media/.gitkeep
app1-slideshow/versions/ol/config.js
app1-slideshow/versions/ol/media/*
!app1-slideshow/versions/ol/media/.gitkeep

app2-chapters/config.js
app2-chapters/media/*
!app2-chapters/media/.gitkeep

app3-multi-screen/config.js
app3-multi-screen/media/*
!app3-multi-screen/media/.gitkeep